{
  "name": "chat-dns",
  "version": "4.3.5",
  "description": "DNSChat - A React Native chat app using DNS TXT queries",
  "main": "entry.tsx",
  "author": "DNSChat contributors",
  "license": "MIT",
  "homepage": "https://github.com/mneves75/dnschat",
  "repository": {
    "type": "git",
    "url": "https://github.com/mneves75/dnschat.git"
  },
  "bugs": {
    "url": "https://github.com/mneves75/dnschat/issues"
  },
  "keywords": [
    "dns",
    "chat",
    "react-native",
    "expo",
    "llm",
    "dns-txt"
  ],
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "node scripts/run-android.js",
    "android:java24": "expo run:android",
    "ios": "expo run:ios",
    "sync-versions": "node scripts/sync-versions.js",
    "sync-versions:dry": "node scripts/sync-versions.js --dry-run",
    "fix-pods": "scripts/fix-cocoapods.sh",
    "clean-ios": "cd ios && rm -rf Pods/ build/ && pod install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:native": "tsgo --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "e2e:axe": "node scripts/e2e-axe.js",
    "e2e:axe:doctor": "node scripts/e2e-axe.js --doctor",
    "e2e:axe:release": "node scripts/e2e-axe.js --create-simulator --delete-created-simulator --build-release --reset-app",
    "test:android": "jest --runInBand --testPathPattern=androidStartupDiagnostics",
    "verify:android": "node scripts/verify-android-setup.js",
    "verify:android-16kb": "node scripts/check-android-16kb.js",
    "verify:sdk-alignment": "node scripts/verify-sdk-alignment.js",
    "verify:typed-routes": "node scripts/verify-typed-routes.js",
    "verify:expo-doctor": "RUBYOPT=-rlogger pnpm exec expo-doctor",
    "verify:react-compiler": "react-compiler-healthcheck",
    "verify:react-doctor": "npx -y react-doctor@latest . --project chat-dns",
    "verify:public-redaction": "node scripts/check-public-redaction.js",
    "verify:security": "pnpm audit && gitleaks detect --source . --redact --no-banner --config .gitleaks.toml",
    "verify:fast": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "verify:all": "pnpm run typecheck && pnpm run lint && pnpm run verify:typed-routes && pnpm run verify:dnsresolver-sync && pnpm run verify:ios-pods && pnpm run verify:react-compiler && pnpm run verify:react-doctor && pnpm run verify:sdk-alignment && pnpm run verify:public-redaction && pnpm run verify:android && pnpm run verify:android-16kb && pnpm run verify:security && pnpm run verify:expo-doctor && pnpm run test",
    "verify:dnsresolver-sync": "node scripts/verify-dnsresolver-sync.js",
    "lint:ast-grep": "node scripts/run-ast-grep.js --config sgconfig.yml",
    "lint": "node scripts/run-ast-grep.js --config sgconfig.yml",
    "dns:harness:build": "tsc -p scripts/tsconfig.harness.json",
    "dns:harness": "pnpm run dns:harness:build && node scripts/dist/run-dns-harness.js",
    "verify:ios-pods": "node scripts/verify-ios-pods-sync.js",
    "prepare": "node scripts/install-git-hooks.js",
    "postinstall": "node scripts/postinstall-ios-pods.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "~57.0.9",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.14.2",
    "date-fns": "^4.1.0",
    "dns-packet": "^5.6.1",
    "expo": "~57.0.10",
    "expo-asset": "~57.0.8",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "6.4.1",
    "react-native-udp": "4.1.7",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.40.3",
    "@types/dns-packet": "^5.6.5",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260615.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "expo-doctor": "1.20.1",
    "jest": "^29.7.0",
    "react-compiler-healthcheck": "1.0.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-udp",
          "react-native-tcp-socket",
          "@dnschat/dns-native",
          "expo-modules-jsi"
        ],
        "listUnknownPackages": true
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
